<Window x:Class="LinqPlinqTask.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LINQ vs PLINQ" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Количество элементов (N):" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="TxtN" Width="100" Text="100000" VerticalContentAlignment="Center"/>
            <Button x:Name="BtnRun" Content="Сгенерировать и обработать" Margin="10,0,0,0" Padding="15,5" Click="BtnRun_Click"/>
        </StackPanel>

        <!-- Поле вывода -->
        <TextBox x:Name="TxtOutput" Grid.Row="1" Margin="10" 
                 IsReadOnly="True" 
                 TextWrapping="Wrap" 
                 VerticalScrollBarVisibility="Auto" 
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"/>
    </Grid>
</Window>